% Knowledge Gap Analysis — Identify structural weaknesses in the codebase
% Detects isolated nodes, untested hotspots, thin communities, and single-file clusters.

% Isolated nodes: symbols with total degree <= 1 (disconnected from dependency graph)
query_metadata("gap_isolated", "Detect isolated symbols with degree <= 1").
query_metadata("gap_isolated", "category", "analysis").
query_metadata("gap_isolated", "tier", "1").
query_metadata("gap_isolated", "severity", "low").
query_metadata("gap_isolated", "description", "Symbols with 0 or 1 total connections - may be dead code, dynamically invoked, or missing integration points").
query_metadata("gap_isolated", "Predicate", "has_knowledge_gap").

query("gap_isolated", Symbol, TotalDegree) :-
    triples(Symbol, "has_out_degree", OutStr),
    triples(Symbol, "has_in_degree", InStr),
    numeric(OutStr, OutDeg),
    numeric(InStr, InDeg),
    TotalDegree is OutDeg + InDeg,
    TotalDegree =< 1.

% Untested hotspots: high-degree symbols with no test coverage
query_metadata("gap_untested_hotspot", "Detect high-degree symbols with no test coverage").
query_metadata("gap_untested_hotspot", "category", "analysis").
query_metadata("gap_untested_hotspot", "tier", "1").
query_metadata("gap_untested_hotspot", "severity", "high").
query_metadata("gap_untested_hotspot", "description", "Symbols with degree >= 5 that have no test coverage - high risk if they break").
query_metadata("gap_untested_hotspot", "Predicate", "has_knowledge_gap").

query("gap_untested_hotspot", Symbol, TotalDegree) :-
    triples(Symbol, "has_out_degree", OutStr),
    triples(Symbol, "has_in_degree", InStr),
    numeric(OutStr, OutDeg),
    numeric(InStr, InDeg),
    TotalDegree is OutDeg + InDeg,
    TotalDegree >= 5,
    not triples(Symbol, "is_test_symbol", "true").

% Thin communities: clusters with fewer than 3 members
query_metadata("gap_thin_community", "Detect communities with fewer than 3 members").
query_metadata("gap_thin_community", "category", "analysis").
query_metadata("gap_thin_community", "tier", "1").
query_metadata("gap_thin_community", "severity", "low").
query_metadata("gap_thin_community", "description", "Communities with < 3 members may be noise or should be merged into larger clusters").
query_metadata("gap_thin_community", "Predicate", "has_knowledge_gap").

query("gap_thin_community", Cluster, Count) :-
    triples(_, "belongs_to_cluster", Cluster),
    aggregates.Count({Cluster}, Cluster, Count),
    Count < 3,
    Count > 0.

% Single-file communities: all members in the same file (monolithic files)
query_metadata("gap_single_file_community", "Detect communities where all members live in one file").
query_metadata("gap_single_file_community", "category", "analysis").
query_metadata("gap_single_file_community", "tier", "1").
query_metadata("gap_single_file_community", "severity", "medium").
query_metadata("gap_single_file_community", "description", "Clusters where all members are in the same file - indicates possible monolithic file that should be split").
query_metadata("gap_single_file_community", "Predicate", "has_knowledge_gap").

query("gap_single_file_community", Cluster, File, Count) :-
    triples(Node, "belongs_to_cluster", Cluster),
    triples(Node, "in_file", File),
    aggregates.Count({Cluster, File}, (Cluster, File), Count),
    Count >= 3,
    not (triples(OtherNode, "belongs_to_cluster", Cluster),
         triples(OtherNode, "in_file", OtherFile),
         OtherFile != File).

% Top isolated symbols for review
query_metadata("gap_isolated_top", "Top-K most isolated symbols").
query_metadata("gap_isolated_top", "category", "analysis").
query_metadata("gap_isolated_top", "tier", "1").
query_metadata("gap_isolated_top", "description", "Returns top-K isolated symbols sorted by degree").
query_metadata("gap_isolated_top", "Predicate", "has_knowledge_gap").

query("gap_isolated_top", Symbol, TotalDegree) :-
    query("gap_isolated", Symbol, TotalDegree),
    rank(TotalDegree, Rank),
    Rank =< 10.

% Top untested hotspots for review
query_metadata("gap_untested_top", "Top-K untested hotspots by degree").
query_metadata("gap_untested_top", "category", "analysis").
query_metadata("gap_untested_top", "tier", "1").
query_metadata("gap_untested_top", "description", "Returns top-K untested symbols sorted by degree").
query_metadata("gap_untested_top", "Predicate", "has_knowledge_gap").

query("gap_untested_top", Symbol, TotalDegree) :-
    query("gap_untested_hotspot", Symbol, TotalDegree),
    rank(TotalDegree, Rank),
    Rank =< 10.