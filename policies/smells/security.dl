% Security Smell Detection — Unsanitized Data Flow
% Detects paths from public APIs to databases that bypass sanitizers.
% Requires tags: public_api, sanitizer, database (injected by virtual.go)

query_metadata("smell_unsanitized_db_access", "category", "security").
query_metadata("smell_unsanitized_db_access", "severity", "critical").
query_metadata("smell_unsanitized_db_access", "description", "Detect paths from public APIs to databases that bypass sanitizers").
query_metadata("smell_unsanitized_db_access", "smell_type", "unsanitized_db_access").
query_metadata("smell_unsanitized_db_access", "tier", "1").
query_metadata("smell_unsanitized_db_access", "remediation", "Insert a sanitizer (validation/middleware/auth) between the public API and database. Ensure all DB access goes through parameterized queries via a repository layer.").
query_metadata("smell_unsanitized_db_access", "remediation", "If no sanitizer exists: add input validation middleware, sanitize SQL parameters, or wrap DB access in a repository that enforces query allowlisting.").

% Base predicate: direct calls from a node
direct_call(A, B) :- triples(A, "calls", B).

% Recursive predicate: transitive reachability WITHOUT hitting a sanitizer
% Depth bound of 10 prevents runaway recursion on large cyclic graphs
reach_without_sanitizer(A, C, Depth) :-
    Depth < 10,
    direct_call(A, B),
    not triples(A, "has_tag", "sanitizer"),
    NextDepth is Depth + 1,
    reach_without_sanitizer(B, C, NextDepth).

% Termination: reached a database node without a sanitizer on the path
reach_without_sanitizer(A, B, _Depth) :-
    direct_call(A, B),
    not triples(A, "has_tag", "sanitizer"),
    triples(B, "has_tag", "database").

% Main query: public API reaching database without sanitizer
% Output: (API, DB, Path) tuples where path is the call chain
query("smell_unsanitized_db_access", API, DB, Path) :-
    triples(API, "has_tag", "public_api"),
    triples(DB, "has_tag", "database"),
    reach_without_sanitizer(API, DB, 0),
    Path = string(API, " -> ", DB).

% Variant: just the file-level pair (no path tracing)
query("smell_unsanitized_db_access_pair", API, DB) :-
    triples(API, "has_tag", "public_api"),
    triples(DB, "has_tag", "database"),
    reach_without_sanitizer(API, DB, 0).

% Count unsafe APIs (how many public APIs reach DB without sanitizer)
query("smell_unsanitized_db_access_count", API, Count) :-
    triples(API, "has_tag", "public_api"),
    findall(DB, (triples(DB, "has_tag", "database"), reach_without_sanitizer(API, DB, 0)), DBs),
    list.length(DBs, Count),
    Count > 0.

% Hub detector: files that call both public_api and database without sanitizer in between
query("smell_security_hub", File, OutDegree, InDegree) :-
    triples(File, "has_tag", "public_api"),
    findall(Callee, (triples(File, "calls", Callee), not triples(Callee, "has_tag", "sanitizer")), CallChain),
    list.length(CallChain, OutDegree),
    OutDegree > 3, % Heavily connected without sanitizer protection
    findall(Caller, triples(Caller, "calls", File), Callers),
    list.length(Callers, InDegree).