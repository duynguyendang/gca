% Composite Severity Scoring — Health Debt Calculation
% Pure Datalog scoring policy that assigns weights to smell types and aggregates health debt per file.
% This shifts Health Debt calculation from Go logic into the Datalog engine.

% === Section 1: Smell Type Weights ===

% Weight definitions: (smell_type, penalty_points)
smell_weight("circular_dependency", 10).
smell_weight("circular_transitive", 15).
smell_weight("layer_violation", 8).
smell_weight("god_file", 6).
smell_weight("hub_anomaly", 4).
smell_weight("unsanitized_db_access", 50).

% === Section 2: Hub Penalty ===
% Files with hub_score >= 10 get an additional 15-point penalty.
hub_penalty(File, 15) :-
    triples(File, "has_hub_score", ScoreStr),
    numeric(ScoreStr, Score),
    Score >= 10.

% === Section 3: Per-File Smell Penalties ===
% For each (File, SmellType) pair, look up the weight.
file_smell_penalty(File, SmellType, Weight) :-
    triples(File, "has_smell", SmellType),
    smell_weight(SmellType, Weight).

% === Section 4: Health Debt Per File ===
% Sums all smell penalties + hub penalty for each file.
health_debt(File, TotalDebt) :-
    triples(File, "has_smell", _),
    % Collect all penalty values for this file
    findall(P, file_smell_penalty(File, _, P), Penalties),
    % Sum the list
    list.sum(Penalties, TotalDebt).

% Also add hub penalty to total debt
health_debt_with_hub(File, TotalDebt) :-
    triples(File, "has_smell", _),
    findall(P, file_smell_penalty(File, _, P), Penalties),
    list.sum(Penalties, BaseDebt),
    (
        hub_penalty(File, HubPenalty),
        TotalDebt is BaseDebt + HubPenalty
    ;
        not hub_penalty(File, _),
        TotalDebt = BaseDebt
    ).

% === Section 5: Smell Count Per File ===
smell_count(File, Count) :-
    triples(File, "has_smell", _),
    findall(S, triples(File, "has_smell", S), Smells),
    list.length(Smells, Count).

% === Section 6: Composite Health Score (0–100) ===
% Each file starts at 100, subtract penalties.
health_score(File, Score) :-
    health_debt_with_hub(File, Debt),
    Score is 100 - Debt,
    Score >= 0.

health_score(File, 0) :-
    health_debt_with_hub(File, Debt),
    Debt >= 100.

% === Section 7: Top-K Unhealthy Files ===
top_unhealthy_files(K, File, Score) :-
    health_score(File, Score),
    Score < 80,
    rank(Score, Rank),
    Rank <= K.

% === Section 8: AI Remediation Prompts (attached as metadata) ===
query_metadata("scoring_health_debt", "description", "Calculate total health debt per file by summing smell penalties and hub penalties").
query_metadata("scoring_health_debt", "category", "scoring").
query_metadata("scoring_health_debt", "remediation", "For each file with health_debt > 20: prioritize refactoring files with circular_transitive (weight 15) and circular_dependency (weight 10) before lower-weight smells").
query_metadata("scoring_health_debt", "remediation", "Hub files (hub_score >= 10) should be reviewed for interface extraction to reduce coupling").
query_metadata("scoring_top_unhealthy", "description", "List top-K files with lowest health scores").
query_metadata("scoring_top_unhealthy", "remediation", "Apply refactoring in order: (1) break circular_transitive cycles, (2) resolve layer_violations, (3) split god_files, (4) extract interfaces from hub files").