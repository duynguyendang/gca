% God File / God Module Detection
% Detects files with excessive imports (>50) or definitions (>30)

query_metadata("smell_god_file", "Detect files with excessive imports (>50) or definitions (>30)").
query_metadata("smell_god_file", "category", "smell").
query_metadata("smell_god_file", "tier", "1").
query_metadata("smell_god_file", "severity", "medium").
query_metadata("smell_god_file", "smell_type", "god_file").

% Files with excessive imports
query_metadata("smell_god_file_imports", "category", "smell").
query_metadata("smell_god_file_imports", "severity", "medium").
query_metadata("smell_god_file_imports", "smell_type", "god_file").
query_metadata("smell_god_file_imports", "Predicate", "has_smell_type").
query_metadata("smell_god_file_imports", "template", `triples(File, "imports", P), not contains(File, ":"), aggregates.Count({File, "imports", P}, File, Count), Count > 50`).

query("smell_god_file_imports", File, Count) :-
    triples(File, "imports", _),
    not contains(File, ":"),
    aggregates.Count({File, "imports", P}, File, Count),
    Count > 50.

% Files with excessive definitions
query_metadata("smell_god_file_defines", "category", "smell").
query_metadata("smell_god_file_defines", "severity", "medium").
query_metadata("smell_god_file_defines", "smell_type", "god_file").
query_metadata("smell_god_file_defines", "Predicate", "has_smell_type").
query_metadata("smell_god_file_defines", "template", `triples(File, "defines", S), not contains(File, ":"), aggregates.Count({File, "defines", S}, File, Count), Count > 30`).

query("smell_god_file_defines", File, Count) :-
    triples(File, "defines", _),
    not contains(File, ":"),
    aggregates.Count({File, "defines", S}, File, Count),
    Count > 30.
